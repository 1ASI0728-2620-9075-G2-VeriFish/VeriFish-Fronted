{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "yakucontrol-v2",
          "appId": "1:767319495769:android:b779eaeca7fd7912e84d48",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "yakucontrol-v2",
          "configurations": {
            "android": "1:767319495769:android:b779eaeca7fd7912e84d48",
            "ios": "1:767319495769:ios:cfa8e1297397d026e84d48",
            "macos": "1:767319495769:ios:cfa8e1297397d026e84d48",
