# ===================================================
# YAKU-FRONTEND (FLUTTER) CONFIGURATION
# ===================================================

# La URL de la API se inyecta en tiempo de compilación con --dart-define:
#
# Desarrollo Web Local (default localhost:8080/api):
# flutter run -d chrome
#
# Desarrollo Android Emulator (default 10.0.2.2:8080/api):
# flutter run
#
# Producción / Staging:
# flutter run -d chrome --dart-define=API_BASE_URL=https://tu-api.ejemplo.com/api
# flutter build web --dart-define=API_BASE_URL=https://tu-api.ejemplo.com/api
# flutter build apk --dart-define=API_BASE_URL=https://tu-api.ejemplo.com/api

API_BASE_URL=http://localhost:8080/api
